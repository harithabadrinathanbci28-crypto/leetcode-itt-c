int* twoOutOfThree(int* nums1, int nums1Size, int* nums2, int nums2Size, int* nums3, int nums3Size, int* returnSize) {
    bool* freq1 = calloc(101, sizeof(bool));
    bool* freq2 = calloc(101, sizeof(bool));
    bool* freq3 = calloc(101, sizeof(bool));
    int* result = malloc(100 * sizeof(int));

    for (int i = 0; i < nums1Size; i++)
        freq1[nums1[i]] = 1;

    for (int i = 0; i < nums2Size; i++)
        freq2[nums2[i]] = 1;

    for (int i = 0; i < nums3Size; i++)
        freq3[nums3[i]] = 1;

    int index = 0;
    for (int i = 1; i < 101; i++)
        if (freq1[i] + freq2[i] + freq3[i] > 1)
            result[index++] = i;

    free(freq1);
    free(freq2);
    free(freq3);
    *returnSize = index;
    return result;
}
