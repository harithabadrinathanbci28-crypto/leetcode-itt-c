
int top = -1;
char stack[1000000];

void push(char a)
{
    stack[++top] = a;
}

void pop()
{
    if (top >= 0)
        top--;
}

bool isValid(char* s)
{
    top = -1;

    int n = strlen(s);

    for (int i = 0; i < n; i++)
    {
        if (s[i] == '(' || s[i] == '{' || s[i] == '[')
        {
            push(s[i]);
        }
        else if (s[i] == ')')
        {
            if (top == -1 || stack[top] != '(')
                return false;
            pop();
        }
        else if (s[i] == '}')
        {
            if (top == -1 || stack[top] != '{')
                return false;
            pop();
        }
        else if (s[i] == ']')
        {
            if (top == -1 || stack[top] != '[')
                return false;
            pop();
        }
    }

    return top == -1;
}
