int lenght(char *str)
{
    int i = 0;
    while (str[i])
        i++;
    return (i);
}

bool palindromeCheck(char *nbr, int len)
{
    int i = 0;
    int k = len * 8 - 1;

    while (i < k)
    {
        if (nbr[i] != nbr[k])
            return (false);
        i++;
        k--;
    }
    return (true);
}

bool isPalindromic(char* s) {
    int x = 0;
    int k = 0;
    int i;
    int len = lenght(s);
    char *nbr = malloc (((len * 8) + 1) * sizeof(char));
    if (!nbr)
        return (false);
    nbr[len * 8] = '\0';
    while (s[x])
    {
        i = 7;
        while (i >= 0)
        {
            nbr[k] = ((s[x] >> i) & 1) + '0';
            k++;
            i--;
        }
        x++;
    }
    return (palindromeCheck(nbr, len));
}
