#include <stdlib.h>
void reverseString(char* s, int sSize) {
    int i;
    char *swap;
    
    i = 0;
    swap = (malloc(sSize * sizeof(char)));
    if (!swap)
    {
        exit(1);
    }

    while (i != sSize)
    {
        swap[i] = s[i];
        i++;
    }

    i = 0;
    
    while(i < sSize)
    {
        s[i] = swap[sSize - 1 - i];
        i++;
    }
    free(swap);
}
